{
  "schema_version": 1,
  "package": "requests",
  "ecosystem": "PyPI",
  "rules": [
    {
      "id": "CA9-REQUESTS-REDIRECT-001",
      "advisory_ids": [
        "CVE-2023-32681",
        "GHSA-j8r2-6x86-q33q"
      ],
      "confidence_prior": 85,
      "affected_modules": [
        "requests.sessions",
        "requests.models"
      ],
      "api_targets": [
        {
          "fqname": "requests.get",
          "kind": "function",
          "aliases": [
            "requests.api.get"
          ]
        },
        {
          "fqname": "requests.post",
          "kind": "function",
          "aliases": [
            "requests.api.post"
          ]
        },
        {
          "fqname": "requests.request",
          "kind": "function",
          "aliases": [
            "requests.api.request"
          ]
        },
        {
          "fqname": "requests.Session.send",
          "kind": "method",
          "aliases": [
            "requests.sessions.Session.send"
          ]
        },
        {
          "fqname": "requests.Session.request",
          "kind": "method",
          "aliases": [
            "requests.sessions.Session.request"
          ]
        }
      ],
      "signals": {
        "keywords": [
          "redirect",
          "cookie",
          "header leak",
          "proxy"
        ]
      },
      "notes": [
        "Information leak on redirect to different host"
      ]
    },
    {
      "id": "CA9-REQUESTS-AUTH-001",
      "advisory_ids": [],
      "confidence_prior": 80,
      "affected_modules": [
        "requests.auth"
      ],
      "api_targets": [
        {
          "fqname": "requests.auth.HTTPBasicAuth",
          "kind": "class"
        },
        {
          "fqname": "requests.auth.HTTPDigestAuth",
          "kind": "class"
        }
      ],
      "signals": {
        "keywords": [
          "authentication",
          "auth bypass",
          "credential"
        ]
      },
      "notes": [
        "Authentication-related vulnerabilities"
      ]
    }
  ]
}
